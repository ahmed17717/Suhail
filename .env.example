# Copy to .env and edit. Every value below is optional except ADMIN_PASSWORD_HASH.
# NEVER commit the real .env.

# --- Admin access --------------------------------------------------------------
# Generate with:  python -m scripts.hash_password
# Leave empty to DISABLE the admin panel entirely (fails closed).
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_MINUTES=30

# --- Branding ------------------------------------------------------------------
APP_TITLE=Suhail — المساعد الافتراضي
ASSISTANT_NAME=سهيل
# Folder holding header_logo.png, assistant_avatar.png, user_avatar.png, favicon.png.
# Point this outside the repository to use organisation-specific branding.
ASSETS_DIR=assets

# --- Storage -------------------------------------------------------------------
DATA_DIR=data
MAX_UPLOAD_MB=20

# --- Models (see docs/DEPLOYMENT.md) --------------------------------------------
LLM_MODEL_PATH=models/Qwen2.5-14B-Instruct-Q4_K_M.gguf
LLM_N_CTX=8192
LLM_N_GPU_LAYERS=-1
LLM_N_THREADS=4
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.6
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Keep model files inside the project and never contact the internet at runtime.
# (scripts.download_models switches this off itself while downloading.)
HF_HOME=models/hf
HF_HUB_OFFLINE=1

# --- Retrieval tuning (re-tune with `make eval` if you change the embedding model) --
TOP_K=6
SIMILARITY_THRESHOLD=1.2
CHUNK_SIZE=350
CHUNK_OVERLAP=80
# Reverse word/letter order of Arabic PDFs that store text in visual order.
# Turn off if your PDFs already extract in the correct order.
PDF_RTL_FIX=true

LOG_LEVEL=INFO
